config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	prepare(prepare)
	plan_l1(plan_l1)
	l1_call(l1_call)
	verify_l1(verify_l1)
	rescreen(rescreen)
	score(score)
	l2_retrieve(l2_retrieve)
	l2_call(l2_call)
	final_gate(final_gate)
	emit(emit)
