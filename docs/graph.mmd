	__start__ --> prepare;
	final_gate -. &nbsp;continue&nbsp; .-> emit;
	l1_call -. &nbsp;failed&nbsp; .-> emit;
	l1_call -. &nbsp;continue&nbsp; .-> verify_l1;
	l2_call -. &nbsp;failed&nbsp; .-> emit;
	l2_call -. &nbsp;continue&nbsp; .-> final_gate;
	l2_retrieve -. &nbsp;failed&nbsp; .-> emit;
	l2_retrieve -. &nbsp;continue&nbsp; .-> l2_call;
	plan_l1 -. &nbsp;failed&nbsp; .-> emit;
	plan_l1 -. &nbsp;continue&nbsp; .-> l1_call;
	prepare -. &nbsp;failed&nbsp; .-> emit;
	prepare -. &nbsp;continue&nbsp; .-> plan_l1;
	rescreen -. &nbsp;failed&nbsp; .-> emit;
	rescreen -. &nbsp;continue&nbsp; .-> score;
	score -. &nbsp;clear&nbsp; .-> emit;
	score -. &nbsp;needs_l2&nbsp; .-> l2_retrieve;
	verify_l1 -. &nbsp;failed&nbsp; .-> emit;
	verify_l1 -. &nbsp;continue&nbsp; .-> rescreen;
	emit --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
