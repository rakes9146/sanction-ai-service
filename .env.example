# Prefer the property files: config/application.yml (defaults) and config/application-local.yml (your keys, copy from application-local.yml.example).
# This .env still works and is read BEFORE them (environment variables win over everything).
# Copy this file to .env and fill it in.  .env is never committed.

# ---- which brain to use -------------------------------------------------------------------
# openai = real LLM (needs the three values below).  fake = a small rule-based DEMO stand-in, not AI, no key needed.
LLM_PROVIDER=fake
# openai = real embeddings.  hash = offline stand-in, good enough for the 12-clause demo corpus.
EMBEDDER=hash

# ---- OpenAI (only when LLM_PROVIDER=openai / EMBEDDER=openai). No model name is built into the code: pick and pin them. ----
OPENAI_API_KEY=
OPENAI_MODEL_L1=
OPENAI_MODEL_L2=
OPENAI_EMBEDDING_MODEL=

# ---- switches ------------------------------------------------------------------------------
AI_ENABLED=true
AI_L2_MAY_CLEAR=true
AI_L2_MAY_CLEAR_FLOOR_L2=false
AI_QA_PERCENT=10
AI_MAX_CONCURRENCY=4
LLM_TIMEOUT_S=30
RESCREEN_TIMEOUT_S=2

# ---- infrastructure ------------------------------------------------------------------------
KAFKA_BOOTSTRAP=localhost:9092
MONGO_URI=mongodb://localhost:27017/?directConnection=true
MONGO_DB=ai_db
QDRANT_PATH=data/qdrant
QDRANT_URL=
SERVER_PORT=8083
